        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasTag -->

    <owl:DatatypeProperty rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasTag">
        <rdfs:domain rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasURI -->

    <owl:DatatypeProperty rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasURI">
        <rdfs:domain rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasValue -->

    <owl:DatatypeProperty rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/hasValue">
        <rdfs:domain rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Action -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Action">
        <rdfs:comment>An operation performed by an agent to achieve a goal or change the state of its environment, potentially involving a single movement or a coordinated sequence of movements.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Agent -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Agent">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing"/>
        <rdfs:comment xml:lang="en">A default representation of an entity (robotic) capable of interacting with its environment.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Archetype -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Archetype">
        <rdfs:comment xml:lang="en">Representing the thematic capabilities of a robotic agent as a controlled vocabulary (E.g., Explorer, Hauler, Designer, Painter, etc.).</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Audition -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Audition">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased"/>
        <rdfs:comment xml:lang="en">A sensor-based capability to perceive and interpret sound.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability">
        <rdfs:comment xml:lang="en">Represents the capability of an Agent. Subclasses differentiate and broadly define what actions an Agent can perform (E.g., Grab, Push, Pull, Lift, Navigate, Etc.).</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/CargoBased -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/CargoBased">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability"/>
        <rdfs:comment xml:lang="en">A capability that enables an agent to carry, transport, or otherwise manage cargo.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Close -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Close">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased"/>
        <owl:disjointWith rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Open"/>
        <rdfs:comment xml:lang="en">A gripper-based capability to close a gripper or another grasping mechanism.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Distance -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Distance">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased"/>
        <rdfs:comment xml:lang="en">A capability that uses sensor measurements to determine the distance between an agent and a spatial entity or a specified location in space.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Environment -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Environment">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing"/>
        <rdfs:comment xml:lang="en">Provide shared situational awareness for all Agents telling the orchestrator where the Agents can go, where Objects are, and what areas are restricted which is essential for planning safe and successful Tasks.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Feature -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Feature">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing"/>
        <rdfs:comment xml:lang="en">A spatial thing that only exists as part of a host object (i.e., holes, color, bumps)</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Format -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Format">
        <rdfs:comment>The structural layout, encoding, or standard container used to store, express, or transmit a piece of data.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Geometry -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Geometry">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing"/>
        <rdfs:comment xml:lang="en">The geometry data of a spatial thing (i.e., mesh data, dimensions)</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Goal -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Goal">
        <rdfs:comment xml:lang="en">Represents the desired outcome or terminal state toward which one or more tasks are directed; Anchors decomposition hierarchies and provides semantics for task sequencing order</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability"/>
        <rdfs:comment xml:lang="en">A capability performed using a gripper or comparable end effector to manipulate a spatial thing.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Location -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Location">
        <rdfs:comment>A digital address or identifier specifying where a resource can be found or accessed.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/LowerThreshold -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/LowerThreshold">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold"/>
        <rdfs:comment xml:lang="en">A threshold that specifies the minimum acceptable value for a specification.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Metadata -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Metadata">
        <rdfs:comment xml:lang="en">Data that defines and describes the characteristics of other data (usually large data not fit for KGs. I.e., PointCloud data) for retrieval and processing.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability"/>
        <rdfs:comment xml:lang="en">A capability that enables an agent to change its own position or orientation through mechanisms such as wheels, rotors, or propulsion systems.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Move -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Move">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <rdfs:comment xml:lang="en">A motion-based capability to change the position of the agent itself.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/NominalThreshold -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/NominalThreshold">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold"/>
        <rdfs:comment xml:lang="en">A threshold that specifies the target or normal operating value for a specification.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Object -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Object">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing"/>
        <rdfs:comment xml:lang="en">Specifications to define a non-autonomous Spatial Thing (not functional by itself).</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Open -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Open">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased"/>
        <rdfs:comment xml:lang="en">A gripper-based capability to open a gripper or another grasping mechanism.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Pick -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Pick">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased"/>
        <owl:disjointWith rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Place"/>
        <rdfs:comment xml:lang="en">A gripper-based capability to grasp and lift a spatial thing from its current location.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Place -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Place">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/GripperBased"/>
        <rdfs:comment xml:lang="en">A gripper-based capability to release or position a grasped spatial thing at a target location.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/PowerBased -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/PowerBased">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability"/>
        <rdfs:comment xml:lang="en">A capability that supplies or controls power.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Press -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Press">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <rdfs:comment xml:lang="en">A motion-based capability to apply force against a spatial thing or surface.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Pull -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Pull">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <owl:disjointWith rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Push"/>
        <rdfs:comment xml:lang="en">A motion-based capability to draw a spatial thing toward the agent or another reference point.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Push -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Push">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <rdfs:comment xml:lang="en">A motion-based capability to move a spatial thing away from the agent or another reference point.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Reach -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Reach">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <rdfs:comment xml:lang="en">A motion-based capability to extend an end effector toward a target spatial thing or location.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Role -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Role">
        <rdfs:comment xml:lang="en">Used to represent the immediate characteristics and participation of a SpatialThing in a specific context (i.e, a Task providing a Role).</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Rotate -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Rotate">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/MotionBased"/>
        <rdfs:comment xml:lang="en">A motion-based capability to change the orientation of an agent or spatial thing about an axis.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Capability"/>
        <rdfs:comment xml:lang="en">A capability that acquires information about an agent, a spatial thing, or the environment through sensors.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialExtent -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialExtent">
        <rdfs:comment xml:lang="en">Captures the positional and relational information that constrains or enables the execution of tasks towards a goal within an avilable environment.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatialThing">
        <rdfs:comment xml:lang="en">A physical thing that exists in time and space.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatiotemporalExtent -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpatiotemporalExtent">
        <rdfs:comment>The spatial and temporal extent of an entity, represented through a trajectory linking places and times.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Specification -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Specification">
        <rdfs:comment xml:lang="en">A quantified boundary or measurable limit that defines the extent of a capability. Example: a robotic gripper&apos;s specification might state it can grasp objects up to 5 kg.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpecificationKind -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SpecificationKind">
        <rdfs:comment>The kind or type of Specification as a controlled vocabulary (I.e., Temperature, Weight, Force, etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/State -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/State">
        <rdfs:comment xml:lang="en">Representing the state, state transitions, and state space of an agent. Useful for predicting and correcting actions, as well as identifying deviations.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Task -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Task">
        <rdfs:comment xml:lang="en">Represents any atomic unit of work to be performed by agents.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/TemporalExtent -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/TemporalExtent">
        <rdfs:comment xml:lang="en">It&apos;s a when (timestamp) for recording Events and provides the how long (duration) for scheduling Tasks, so you have perfect timeline of everything that happened.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold">
        <rdfs:comment>The safe and effective operational boundaries of a specification that are further defined using the upper, lower, and nominal subclasses.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Touch -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Touch">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased"/>
        <rdfs:comment xml:lang="en">A sensor-based capability to detect contact, pressure, texture, or other tactile properties.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Unit -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Unit">
        <rdfs:comment>The type or kind of Unit as a controlled vocabulary (I.e., Grams, Kilograms, Meters, Fahrenheit, etc.)</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/UpperThreshold -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/UpperThreshold">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Threshold"/>
        <rdfs:comment xml:lang="en">A threshold that specifies the maximum acceptable value for a specification.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Vision -->

    <owl:Class rdf:about="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/Vision">
        <rdfs:subClassOf rdf:resource="https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/SensorBased"/>
        <rdfs:comment xml:lang="en">A sensor-based capability to perceive and interpret visual information.</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


