# CQ 17: Physical objects required by the selected atomic task.
# Feature and Environment targets are excluded from the Object result set.
PREFIX robo-ont: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/ontology#>
PREFIX robo-r: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/resource#>

SELECT DISTINCT ?object ?name
WHERE {
  VALUES ?task { robo-r:task_01_step_1 }
  ?task robo-ont:requiresSpatialThing ?object .
  ?object a robo-ont:Object ;
          robo-ont:hasMetadata/robo-ont:hasName ?name .
}
ORDER BY ?name
