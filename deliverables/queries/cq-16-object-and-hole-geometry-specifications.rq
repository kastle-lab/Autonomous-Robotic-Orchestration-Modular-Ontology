PREFIX robo-ont: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/ontology#>

SELECT ?object ?feature ?geometry ?kind ?thresholdType ?value ?unit WHERE {
  ?object a robo-ont:Object ;
          robo-ont:hasFeature ?feature .
  ?feature a robo-ont:Feature ;
           robo-ont:hasGeometry ?geometry .
  ?geometry a robo-ont:Geometry ;
            robo-ont:hasPhysicalSpecification ?specification .
  ?specification a robo-ont:Specification ;
                 robo-ont:isSpecificationOf ?kind ;
                 robo-ont:hasThreshold ?threshold .
  ?threshold a ?thresholdType ;
             robo-ont:hasValue ?value ;
             robo-ont:isUnitOf ?unit .
  FILTER(?thresholdType IN (
    robo-ont:LowerThreshold,
    robo-ont:NominalThreshold,
    robo-ont:UpperThreshold
  ))
}
ORDER BY ?object ?feature ?kind ?thresholdType
