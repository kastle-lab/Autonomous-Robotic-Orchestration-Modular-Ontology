# Query 6: All descriptive metadata for each Object.
PREFIX robo-ont: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?objectId ?objectLabel ?metadataId ?metadataPropertyName
                ?metadataValueDisplay
WHERE {
  ?object a robo-ont:Object ;
          robo-ont:hasMetadata ?metadata .
  ?metadata ?metadataProperty ?metadataValue .
  FILTER(?metadataProperty != rdf:type)
  OPTIONAL { ?object rdfs:label ?objectLabel . }
  BIND(REPLACE(STR(?object), "^.*[#/]", "") AS ?objectId)
  BIND(REPLACE(STR(?metadata), "^.*[#/]", "") AS ?metadataId)
  BIND(REPLACE(STR(?metadataProperty), "^.*[#/]", "") AS ?metadataPropertyName)
  BIND(IF(ISIRI(?metadataValue),
          REPLACE(STR(?metadataValue), "^.*[#/]", ""),
          ?metadataValue) AS ?metadataValueDisplay)
}
ORDER BY ?objectLabel ?metadataPropertyName ?metadataValueDisplay
