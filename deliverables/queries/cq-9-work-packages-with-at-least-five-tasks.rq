# CQ 9: Work-package Goals with at least X direct atomic tasks.
# Change the HAVING threshold to the desired X.
PREFIX robo-ont: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?goal ?label (COUNT(DISTINCT ?task) AS ?taskCount)
WHERE {
  ?goal a robo-ont:Goal ;
        rdfs:label ?label ;
        robo-ont:hasTask ?task .
}
GROUP BY ?goal ?label
HAVING (COUNT(DISTINCT ?task) >= 5)
ORDER BY DESC(?taskCount) ?goal
