# Query 5 (previous query 7): Hardware and object physical specifications.
# The current mapping emits generic Threshold nodes, without lower/nominal/
# upper threshold subclasses.
PREFIX robo-ont: <https://github.com/kastle-lab/Autonomous-Robotic-Orchestration-Modular-Ontology/lod/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?hardware ?hardwareName ?serial ?kind ?value ?unit
WHERE {
  ?hardware robo-ont:hasPhysicalSpecification ?specification .
  ?specification a robo-ont:Specification ;
                 robo-ont:isSpecificationOf ?kind ;
                 robo-ont:hasThreshold ?threshold .
  ?threshold a robo-ont:Threshold ;
             robo-ont:hasValue ?value .

  OPTIONAL { ?hardware rdfs:label ?hardwareName . }
  OPTIONAL { ?hardware robo-ont:hasMetadata/robo-ont:hasName ?hardwareName . }
  OPTIONAL { ?hardware robo-ont:hasMetadata/robo-ont:hasSerial ?serial . }
  OPTIONAL { ?threshold robo-ont:isUnitOf ?unit . }
}
ORDER BY ?hardwareName ?serial ?kind ?value
